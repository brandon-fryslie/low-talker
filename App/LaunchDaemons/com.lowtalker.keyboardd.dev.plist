<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The development installation's keyboard helper, as the shipped app registers it
         through SMAppService, which reads this from Contents/Library/LaunchDaemons and
         runs the program named here from inside the bundle.

         Label and MachServices carry one name on purpose: the two installations run side
         by side, and within one of them the launchd job and the Mach service share a name
         so that a second claimant is refused at bootstrap rather than run without an
         endpoint. A test holds every string here to the Flavor it belongs to.

         ProgramArguments passes the flavor because the helper has no other way to know
         which installation it serves - the binary in both bundles is the same program.

         KeepAlive after an unsuccessful exit only: the helper exits 0 on purpose when
         starting again would not help, and launchd knows no other way to be told that. -->
    <key>Label</key><string>com.lowtalker.keyboardd.dev</string>
    <key>BundleProgram</key><string>Contents/MacOS/lowtalker-keyboardd</string>
    <key>ProgramArguments</key>
    <array>
        <string>Contents/MacOS/lowtalker-keyboardd</string>
        <string>--flavor</string>
        <string>development</string>
    </array>
    <key>MachServices</key><dict><key>com.lowtalker.keyboardd.dev</key><true/></dict>
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
</dict>
</plist>
