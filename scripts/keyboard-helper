#!/usr/bin/env bash
# One installation's root keyboard helper, installed and removed on this Mac by an agent
# alone.
#
#   keyboard-helper install [flavor]    register .build/debug/lowtalker-keyboardd as a LaunchDaemon
#   keyboard-helper uninstall [flavor]  stop it and remove the job
#   keyboard-helper state [flavor]      what launchd says about the job
#   keyboard-helper log [flavor]        what the helper has said in the last ten minutes
#   keyboard-helper names [flavor]      the names it would act under, for the test below
#
# `flavor` is release or development and defaults to development, for the reason
# `lowtalker --flavor` defaults to it: this tree is the development copy, and reaching
# into the installed copy's job is a thing to ask for by name.
#
# Two registration paths exist and this is the one that needs nobody: a plist in
# /Library/LaunchDaemons bootstrapped with launchctl runs as root with no approval
# anywhere. SMAppService.daemon is the shipped app's path, and it leaves the job
# .requiresApproval until a person clicks it in Login Items - which is 3ti.7's problem and
# cannot be an agent's. Same binary either way; only who registers it differs.
#
# Within one installation the label and the Mach service carry one name, so this script
# and that installation's app are two claimants on one record and the second is refused at
# bootstrap - exit 5, "Bootstrap failed: Input/output error" - instead of running without
# an endpoint. Across installations every name differs, which is what lets both copies run
# at once. Sources/Flavors/Flavor.swift decides those names and records why; the copies
# below are held to it by HelperPlistTests, because neither bash nor a plist can read a
# Swift constant. [LAW:one-source-of-truth]
#
# What no label governs is a helper started by hand from a terminal: it holds the service
# with no job for launchd to refuse. So install still reads back whether its job got the
# name and says so when it did not. [LAW:no-silent-failure]
#
# Nothing here says who may call the helper. It admits whoever is signed by the
# certificate that signed it, which `make helper` and `make cli` make the same one.
set -euo pipefail

# The copies of Flavor.swift this script needs, built the way Flavor builds them - one
# release name and one suffix - so a rename there is one edit here.
RELEASE_SERVICE="com.lowtalker.keyboardd"
DEVELOPMENT_SUFFIX=".dev"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HELPER="${ROOT}/.build/debug/lowtalker-keyboardd"

die() { echo "keyboard-helper: $*" >&2; exit 1; }

# [LAW:parse-dont-validate] The one place a flavor word becomes the names launchd files
# this job under. A word that is neither stops here, before a sudo writes a plist under a
# name nobody meant.
resolve() {
  case "$1" in
    release)     SERVICE="$RELEASE_SERVICE" ;;
    development) SERVICE="${RELEASE_SERVICE}${DEVELOPMENT_SUFFIX}" ;;
    *) die "unknown flavor \"$1\" - expected release or development" ;;
  esac
  FLAVOR="$1"
  LABEL="$SERVICE"
  PLIST="/Library/LaunchDaemons/${LABEL}.plist"
}

# [LAW:parse-dont-validate] Who holds this flavor's label right now, read before anything
# is written under it: `none`, or the path launchd reports for the job. `launchctl print`
# is a debug dump rather than an interface, so the reading is pinned to the one field that
# separates the two registration paths - measured on this Mac, 2026-09-12, with the
# release app running:
#
#   the app, through SMAppService:  path = (submitted by smd.919)
#   a plist bootstrapped by hand:   path = /Library/LaunchDaemons/<label>.plist
#
# Any plist under /Library/LaunchDaemons is the second kind, whatever its file is called:
# launchd files a job by the Label inside the plist, and OnboardingProbe.standing draws
# the line in the same place, so the step the app prints and this script agree on which
# holder it names. [LAW:single-enforcer]
#
# [LAW:no-silent-failure] Only launchd's own "no such job" means nobody holds the label.
# A sudo that was refused, or a launchctl that failed some other way, has read nothing,
# and reading nothing as "free" is what would write a plist over the app's job.
claimant() {
  local record path
  if record=$(sudo launchctl print "system/${LABEL}" 2>&1); then
    path=$(awk '/^[[:space:]]*path = / { sub(/^[[:space:]]*path = /, ""); print; exit }' <<<"$record")
    # A record with no path read nothing about who holds the label, and nothing is not an
    # answer to act on. [LAW:no-silent-failure]
    [ -n "$path" ] || die "launchd reports a job under ${LABEL} with no path, so who holds it is unknown: ${record}"
    printf '%s' "$path"
  elif grep -q "Could not find service" <<<"$record"; then
    printf none
  else
    die "could not read who holds ${LABEL}: ${record}"
  fi
}

# A holder that is not a plist job is the installation's own app, registered through
# SMAppService, and booting it out would take its Background Task Management record with
# it. So it is named rather than touched.
held_by_the_app() {
  cat <<MSG
${LABEL} is held by ${FLAVOR}'s own app, registered through SMAppService - launchd
reports it at:
  path = $1
Booting it out would take its Background Task Management record with it, so it is left
alone. Quit the app and turn it off in Login Items & Extensions instead. Read the record:
  sudo launchctl print system/${LABEL}
MSG
}

# A path is any bytes and a plist is XML, so the four characters XML reserves are escaped
# once, here, before the path is written into one. [LAW:parse-dont-validate]
xml_escape() {
  printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'
}

install_helper() {
  [ -x "$HELPER" ] || die "no helper at $HELPER - run 'make helper' first"
  # An ad hoc helper refuses to start, for a reason it logs; said here as well, before
  # a job is registered that would only ever start and stop. [LAW:no-silent-failure]
  # Captured rather than piped: grep -q closes the pipe at its first match, and under
  # pipefail codesign's resulting SIGPIPE would fail a signature that passed.
  signature=$(codesign -dvv "$HELPER" 2>&1) || die "codesign could not read $HELPER: $signature"
  grep -q '^Authority=' <<<"$signature" \
    || die "$HELPER is signed ad hoc and would admit no caller - run 'make helper', which signs it with the dev identity"

  # [LAW:single-enforcer] launchd enforces one job per label - the second bootstrap under
  # a held label exits 5 - and that refusal is the whole reason Flavor.swift gives the
  # label and the service one name. This script used to defeat it three lines above the
  # bootstrap, clearing whatever was loaded first, so the enforcer could never fire. With
  # one name per flavor the holder it cleared was normally the installation's own app:
  # BTM files one approval record per label, and the app that came back found its daemon
  # bound to this plist's path, logged "Invalid path: Contents/MacOS/lowtalker-keyboardd",
  # and never spawned - low-keyboard-3ti.66o, measured before the labels were collapsed.
  #
  # So the holder is read once and answered, never cleared blind.
  # [LAW:dataflow-not-control-flow]
  local holder
  holder=$(claimant)
  case "$holder" in
    none|/Library/LaunchDaemons/*) ;;
    *) die "$(held_by_the_app "$holder")" ;;
  esac
  # KeepAlive after an unsuccessful exit, not RunAtLoad alone: this owns a device whose
  # readiness costs a second, and a helper that stayed dead after a crash would answer
  # nothing until someone noticed. Restarting is the behaviour that fails loudly instead
  # of quietly - and it is how the helper comes back after the daemon it holds open goes
  # away. A helper that will not start exits 0 on purpose, with the reason in its log,
  # because 0 is the one exit launchd can be told not to restart.
  #
  # The helper speaks through the unified log; stderr is kept for what it cannot route
  # there, which is a crash. Under /Library/Logs, which only root and admins may write:
  # a fixed name under /tmp is a file anyone may plant for root to open.
  helper_xml="$(xml_escape "$HELPER")"
  sudo tee "$PLIST" >/dev/null <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>${LABEL}</string>
    <key>ProgramArguments</key><array><string>${helper_xml}</string><string>--flavor</string><string>${FLAVOR}</string></array>
    <key>MachServices</key><dict><key>${SERVICE}</key><true/></dict>
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <key>StandardErrorPath</key><string>/Library/Logs/${LABEL}.crash.log</string>
</dict>
</plist>
PLIST_EOF
  sudo chown root:wheel "$PLIST"
  sudo chmod 644 "$PLIST"

  # A previous plist job under this label, torn down here rather than at the reading
  # above: everything that can refuse this install has now refused, so this is the last
  # moment before the new job is loaded and not a state left behind by a later failure.
  # A plist under another file name goes too, or it would load first at the next boot and
  # hold the label against this one. [LAW:no-ambient-temporal-coupling]
  case "$holder" in
    none) ;;
    "$PLIST") sudo launchctl bootout "system/${LABEL}" ;;
    *) sudo launchctl bootout "system/${LABEL}"; sudo rm -f "$holder" ;;
  esac
  sudo launchctl bootstrap system "$PLIST"

  # The endpoint is handed out at load, so the answer is there before the helper runs.
  # A job that did not get it is torn back down: left loaded it would be a root process
  # nobody can reach, restarted by KeepAlive forever. [LAW:no-silent-failure]
  record=$(sudo launchctl print "system/${LABEL}")
  grep -q "\"${SERVICE}\" = {" <<<"$record" || {
    sudo launchctl bootout "system/${LABEL}"
    sudo rm -f "$PLIST"
    die "launchd left ${SERVICE} with another claimant, so this job was not installed. No label this script governs holds it: a helper started by hand from a terminal, or a job under some other label that names this service - which is what every installation predating the joined labels looks like. Find both:
  pgrep -fl lowtalker-keyboardd
  sudo grep -l '>${SERVICE}<' /Library/LaunchDaemons/*.plist
launchd names the owner with:
  log show --last 1m --predicate 'process == \"launchd\" AND eventMessage CONTAINS \"${SERVICE}\"'"
  }
  echo "keyboard-helper: installed. Read it with: $0 log"
}

# Removes every plist job under this flavor's label, and never the app's. The same
# reading as install, for the same reason: `bootout` of the app's registration would take
# its approval record along with it.
#
# This flavor's plist goes whoever holds the label. With no job loaded from it, it is inert
# until the next boot - where it loads before the app registers and holds the label against
# it, which is the one thing the reader running this wanted gone.
# [LAW:no-silent-failure] A holder left running is named rather than passed over, because
# "removed" over a job still running sends the next reader looking in the wrong place.
uninstall_helper() {
  local holder
  holder=$(claimant)
  sudo rm -f "$PLIST"
  case "$holder" in
    none) ;;
    /Library/LaunchDaemons/*) sudo launchctl bootout "system/${LABEL}"; sudo rm -f "$holder" ;;
    *) die "${PLIST} is removed, and the job holding the label is not.
$(held_by_the_app "$holder")" ;;
  esac
  echo "keyboard-helper: removed"
}

state_helper() {
  sudo launchctl print "system/${LABEL}" | awk '/state|pid|program|path|last exit/ { print }'
}

# The flavor's service name is the one subsystem to read: a helper that cannot tell which
# flavor it is files its refusal under every flavor's, so it is found here too.
log_helper() {
  log show --last 10m --style compact --predicate "subsystem == \"${SERVICE}\""
}

# What this script resolved, in the tab-separated shape `lowtalker driver pins` uses, so
# the test that holds these copies to Flavor reads what install actually acts under rather
# than a second spelling of it.
names_helper() {
  printf 'flavor\t%s\nlabel\t%s\nservice\t%s\nplist\t%s\n' "$FLAVOR" "$LABEL" "$SERVICE" "$PLIST"
}

verb="${1:-}"
resolve "${2:-development}"

case "$verb" in
  install)   install_helper ;;
  uninstall) uninstall_helper ;;
  state)     state_helper ;;
  log)       log_helper ;;
  names)     names_helper ;;
  *) die "usage: keyboard-helper install|uninstall|state|log|names [release|development]" ;;
esac
