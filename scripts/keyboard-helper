#!/usr/bin/env bash
# The root keyboard helper, installed and removed on this Mac by an agent alone.
#
# Two registration paths exist and this is the one that needs nobody: a plist in
# /Library/LaunchDaemons bootstrapped with launchctl runs as root with no approval
# anywhere. SMAppService.daemon is the shipped app's path, and it leaves the job
# .requiresApproval until a person clicks it in Login Items - which is 3ti.7's problem and
# cannot be an agent's. Same binary either way; only who registers it differs.
#
# [LAW:one-source-of-truth] The caller requirement is computed here from the client binary
# that will actually call, and written into the job. Nothing hard-codes an identity: a
# requirement compiled into the daemon would name whatever was true when it was built.
set -euo pipefail

LABEL="com.lowtalker.keyboardd"
PLIST="/Library/LaunchDaemons/${LABEL}.plist"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HELPER="${ROOT}/.build/debug/lowtalker-keyboardd"
CLIENT="${ROOT}/.build/debug/lowtalker"

die() { echo "keyboard-helper: $*" >&2; exit 1; }

# The client's own code directory hash, which is what the daemon will require of whoever
# connects. It pins this exact binary: an ad-hoc signature can be forged by anyone, so
# requiring "identifier lowtalker" alone would let any process claim to be the client. A
# Developer ID requirement replaces this in 3ti.8; until then the hash is the honest one,
# and it is why re-signing the client means re-installing the job.
client_requirement() {
  [ -x "$CLIENT" ] || die "no client at $CLIENT - run 'make cli' first"
  local hash
  hash=$(codesign -d -vvv "$CLIENT" 2>&1 | awk -F= '/^CDHash=/ { print $2; exit }')
  [ -n "$hash" ] || die "could not read the client's code directory hash - is $CLIENT signed?"
  echo "cdhash H\"${hash}\""
}

install_helper() {
  [ -x "$HELPER" ] || die "no helper at $HELPER - run 'swift build' first"
  local requirement
  requirement=$(client_requirement)
  echo "keyboard-helper: callers must satisfy: ${requirement}"

  # KeepAlive, not RunAtLoad alone: this owns a device whose readiness costs a second, and
  # a helper that stayed dead after one bad start would answer nothing until someone
  # noticed. Restarting is the behaviour that fails loudly instead of quietly.
  sudo tee "$PLIST" >/dev/null <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>${LABEL}</string>
    <key>ProgramArguments</key><array><string>${HELPER}</string></array>
    <key>MachServices</key><dict><key>${LABEL}</key><true/></dict>
    <key>EnvironmentVariables</key>
    <dict><key>LOWTALKER_CALLER_REQUIREMENT</key><string>${requirement}</string></dict>
    <key>KeepAlive</key><true/>
    <key>StandardErrorPath</key><string>/tmp/${LABEL}.log</string>
</dict>
</plist>
PLIST_EOF
  sudo chown root:wheel "$PLIST"
  sudo chmod 644 "$PLIST"

  sudo launchctl bootout "system/${LABEL}" 2>/dev/null || true
  sudo launchctl bootstrap system "$PLIST"
  echo "keyboard-helper: installed. Log: /tmp/${LABEL}.log"
}

uninstall_helper() {
  sudo launchctl bootout "system/${LABEL}" 2>/dev/null || true
  sudo rm -f "$PLIST"
  echo "keyboard-helper: removed"
}

case "${1:-}" in
  install)   install_helper ;;
  uninstall) uninstall_helper ;;
  state)
    sudo launchctl print "system/${LABEL}" 2>/dev/null | awk '/state|pid|program|path/ { print }' \
      || echo "keyboard-helper: not installed"
    ;;
  requirement) client_requirement ;;
  *) die "usage: keyboard-helper install|uninstall|state|requirement" ;;
esac
