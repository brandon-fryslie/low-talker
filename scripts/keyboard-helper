#!/usr/bin/env bash
# The root keyboard helper, installed and removed on this Mac by an agent alone.
#
#   keyboard-helper install    register .build/debug/lowtalker-keyboardd as a LaunchDaemon
#   keyboard-helper uninstall  stop it and remove the job
#   keyboard-helper state      what launchd says about the job
#   keyboard-helper log        what the helper has said in the last ten minutes
#
# Two registration paths exist and this is the one that needs nobody: a plist in
# /Library/LaunchDaemons bootstrapped with launchctl runs as root with no approval
# anywhere. SMAppService.daemon is the shipped app's path, and it leaves the job
# .requiresApproval until a person clicks it in Login Items - which is 3ti.7's problem and
# cannot be an agent's. Same binary either way; only who registers it differs.
#
# Nothing here says who may call the helper. It admits whoever is signed by the
# certificate that signed it, which `make helper` and `make cli` make the same one.
set -euo pipefail

LABEL="com.lowtalker.keyboardd"
PLIST="/Library/LaunchDaemons/${LABEL}.plist"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HELPER="${ROOT}/.build/debug/lowtalker-keyboardd"

die() { echo "keyboard-helper: $*" >&2; exit 1; }

install_helper() {
  [ -x "$HELPER" ] || die "no helper at $HELPER - run 'make helper' first"
  # An ad hoc helper refuses to start, for a reason it logs; said here as well, before
  # a job is registered that will only ever exit 78. [LAW:no-silent-failure]
  # Captured rather than piped: grep -q closes the pipe at its first match, and under
  # pipefail codesign's resulting SIGPIPE would fail a signature that passed.
  signature=$(codesign -dvv "$HELPER" 2>&1) || die "codesign could not read $HELPER: $signature"
  grep -q '^Authority=' <<<"$signature" \
    || die "$HELPER is signed ad hoc and would admit no caller - run 'make helper', which signs it with the dev identity"

  # KeepAlive, not RunAtLoad alone: this owns a device whose readiness costs a second, and
  # a helper that stayed dead after one bad start would answer nothing until someone
  # noticed. Restarting is the behaviour that fails loudly instead of quietly - and it is
  # how the helper comes back after the daemon it holds open goes away.
  #
  # The helper speaks through the unified log; stderr is kept for what it cannot route
  # there, which is a crash.
  sudo tee "$PLIST" >/dev/null <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>${LABEL}</string>
    <key>ProgramArguments</key><array><string>${HELPER}</string></array>
    <key>MachServices</key><dict><key>${LABEL}</key><true/></dict>
    <key>KeepAlive</key><true/>
    <key>StandardErrorPath</key><string>/tmp/${LABEL}.crash.log</string>
</dict>
</plist>
PLIST_EOF
  sudo chown root:wheel "$PLIST"
  sudo chmod 644 "$PLIST"

  # A job already loaded is replaced. bootout refuses a job that is not there, and that
  # is the ordinary case for a first install, so its answer is read rather than obeyed.
  if sudo launchctl print "system/${LABEL}" >/dev/null 2>&1; then
    sudo launchctl bootout "system/${LABEL}"
  fi
  sudo launchctl bootstrap system "$PLIST"
  echo "keyboard-helper: installed. Read it with: $0 log"
}

uninstall_helper() {
  if sudo launchctl print "system/${LABEL}" >/dev/null 2>&1; then
    sudo launchctl bootout "system/${LABEL}"
  fi
  sudo rm -f "$PLIST"
  echo "keyboard-helper: removed"
}

state_helper() {
  sudo launchctl print "system/${LABEL}" | awk '/state|pid|program|path|last exit/ { print }'
}

log_helper() {
  log show --last 10m --style compact --predicate "subsystem == \"${LABEL}\""
}

case "${1:-}" in
  install)   install_helper ;;
  uninstall) uninstall_helper ;;
  state)     state_helper ;;
  log)       log_helper ;;
  *) die "usage: keyboard-helper install|uninstall|state|log" ;;
esac
