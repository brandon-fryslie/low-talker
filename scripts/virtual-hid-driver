#!/usr/bin/env bash
# Installs, removes, and reports the Karabiner-DriverKit-VirtualHIDDevice driver
# extension, from the public pqrs-org package alone. Karabiner-Elements is never
# involved and is never a requirement.
#
#   virtual-hid-driver state             the machine's driver state
#   virtual-hid-driver expect <verdict>  assert that state, or fail loudly
#   virtual-hid-driver install           download, install, activate
#   virtual-hid-driver remove            deactivate, delete files, forget receipt
#
# `state` writes the fact table to stderr for a reader and the one-word verdict to
# stdout for a caller, so `$(virtual-hid-driver state)` is exactly the verdict.
#
# Run as the console user, not under sudo: the driver Manager must be the logged-in
# user, because macOS attributes the activation request to whoever asks and the
# approval the user gives answers that request. The file steps take sudo themselves.
#
# Held to bash 3.2, the newest /bin/bash Apple ships, so no arrays and no associative
# arrays: this has to run on a Mac with nothing installed on it yet.
#
# Two version numbers travel together and are not the same number. The *package* is
# versioned 8.4.0 and carries the Manager and Daemon apps; the *driver extension*
# inside it is versioned 1.8.0, which is what `systemextensionsctl` reports. The
# extension version has not moved across many package releases, so a package upgrade
# that leaves `systemextensionsctl` still reading 1.8.0 has not failed.
set -euo pipefail

# [LAW:one-source-of-truth] Every fact about which artifact we install lives here and
# nowhere else. README.md quotes several of them for a reader following the runbook by
# hand; `make check-docs` names which ones and fails when a copy disagrees. Which
# constants those are is the recipe's to say, not this comment's - a list kept in both
# places is the drift that target exists to catch.
PKG_VERSION=8.4.0
PKG_SHA256=8e6c433f4e3aaa0403f6f3c72849cfcd054d52d83b53d7408771ade54f1d49a1
DEXT_VERSION=1.8.0
BUNDLE_ID=org.pqrs.Karabiner-DriverKit-VirtualHIDDevice
# Karabiner-Elements is a separate product that ships this same driver and writes its
# own receipt beside ours. `remove` refuses while this one is present, because the two
# share the payload paths below and nothing here could put back what it deleted.
ELEMENTS_RECEIPT=org.pqrs.Karabiner-Elements
TEAM_ID=G43BCU2T37
SIGNING_AUTHORITY="Developer ID Installer: Fumihiko Takayama ($TEAM_ID)"
# The three spaces are pkgutil's own indent. Matched whole-line below: a chain entry
# whose Common Name carried this text would satisfy a substring match.
TRUSTED_STATUS="   Status: signed by a developer certificate issued by Apple for distribution"
PKG_URL="https://github.com/pqrs-org/Karabiner-DriverKit-VirtualHIDDevice/releases/download/v$PKG_VERSION/Karabiner-DriverKit-VirtualHIDDevice-$PKG_VERSION.pkg"

MANAGER_APP=/Applications/.Karabiner-VirtualHIDDevice-Manager.app
MANAGER="$MANAGER_APP/Contents/MacOS/Karabiner-VirtualHIDDevice-Manager"
SUPPORT_DIR="/Library/Application Support/org.pqrs/Karabiner-DriverKit-VirtualHIDDevice"
IO_NODE=org_pqrs_Karabiner_DriverKit_VirtualHIDDeviceRoot

die() { echo "virtual-hid-driver: $*" >&2; exit 1; }

# Where the downloaded package lands: one fixed directory under the machine's own temp
# area, holding one fixed filename.
#
# This script deletes no directories. It keeps a stable path instead of a per-run
# temporary one, so the only thing it ever removes here is that single named file, and
# clearing the directory itself is left to whoever reaps the temp area.
VHID_SCRATCH="${TMPDIR:-/tmp}/low-talker-virtual-hid-driver"

# How a probe reports that it could not read the machine, as opposed to reading it and
# finding nothing. The reason goes to stderr and the word goes to stdout.
#
# Probes cannot use `die`. Every one of them is reached through a command
# substitution, and bash swallows a fatal error raised in there: the caller receives an
# empty string, carries on, and the run ends 0. So each probe is total, returns a word
# for every outcome including its own failure, and the verbs below - which do run in
# the main shell, where exiting works - refuse to act on that word.
# [LAW:no-silent-failure]
probe_failure() { echo "virtual-hid-driver: $*" >&2; echo probe-failed; }

# ---------------------------------------------------------------------------
# The facts
#
# Four probes. They are the authoritative reading of the machine, and the verdict
# below is derived from them and from nothing else.
# ---------------------------------------------------------------------------

# The driver extension's registration state, as one canonical word.
#
# [LAW:parse-dont-validate] The bracket text `systemextensionsctl` prints is parsed
# once, here, into a word the rest of the script matches exactly. No caller greps that
# listing again, so no caller can come to a different conclusion about what it said.
#
# The mapping is total: text nobody here has seen becomes `unknown` rather than the
# nearest familiar word. Misfiling an unseen state is how `remove` would come to report
# success on a machine it did not understand. [LAW:no-silent-failure]
registration_word() {
  case "$1" in
    'activated enabled')                           echo enabled ;;
    'activated disabled')                          echo disabled ;;
    'activated waiting for user')                  echo waiting ;;
    'terminated waiting to uninstall on reboot')   echo pending-reboot ;;
    *)                                             echo unknown ;;
  esac
}

dext_registration() {
  local listing pattern lines status extracted live
  listing=$(systemextensionsctl list) && status=0 || status=$?
  if (( status != 0 )); then
    probe_failure "could not list the system extensions (systemextensionsctl exit $status)"
    return 0
  fi
  pattern=$(printf '\t%s\t%s (' "$TEAM_ID" "$BUNDLE_ID")

  # grep exits 1 for "found nothing" and 2 or more for "could not look". Collapsing
  # those together is how a broken probe comes to read as "no driver installed", so
  # they are told apart here. [LAW:no-silent-failure]
  lines=$(grep -F "$pattern" <<<"$listing") && status=0 || status=$?
  if (( status > 1 )); then
    probe_failure "could not search the systemextensionsctl listing (grep exit $status)"
    return 0
  fi

  # A Mac that has been upgraded but not yet restarted lists the bundle twice: the
  # incoming registration, and the outgoing one still waiting on a reboot. The
  # outgoing entry governs nothing, so it is dropped and what remains is the answer.
  #
  # The two steps stay separate values because they answer different questions, and an
  # empty result means something different for each: nothing extracted is a listing
  # this probe cannot parse, while nothing left after the filter is a genuine
  # pending-reboot. Collapsing them reports an unread machine as a state `remove` will
  # happily finish from. [LAW:no-silent-failure]
  extracted=$(sed -n 's/.*\[\(.*\)\]$/\1/p' <<<"$lines")
  live=$(sed '/^terminated waiting to uninstall on reboot$/d' <<<"$extracted")

  if [[ -z $lines ]]; then
    echo unregistered
  elif [[ -z $extracted ]]; then
    probe_failure "systemextensionsctl listed $BUNDLE_ID but no line carried a bracketed state"
  elif [[ -z $live ]]; then
    echo pending-reboot
  elif [[ $live == *$'\n'* ]]; then
    echo ambiguous
  else
    registration_word "$live"
  fi
}

# Which of the package's two payload trees are on disk.
installed_files() {
  local manager=no support=no
  [[ -d $MANAGER_APP ]] && manager=yes
  [[ -d $SUPPORT_DIR ]] && support=yes
  case "$manager$support" in
    yesyes) echo both ;;
    nono)   echo none ;;
    *)      echo partial ;;
  esac
}

# The version of one installer receipt, or `none`. The receipt outlives the files,
# because the package's own uninstall scripts never call `pkgutil --forget`.
#
# The id is a parameter because two products leave receipts this script cares about and
# reading them differs in nothing else. [LAW:one-type-per-behavior]
receipt_version() {
  local id=$1 out status
  out=$(pkgutil --pkg-info "$id" 2>&1) && status=0 || status=$?

  # pkgutil exits non-zero for two unrelated reasons: this Mac holds no such receipt,
  # which is a normal answer, and pkgutil could not run, which is not. Sending both
  # down the "no receipt" path is how a broken probe would come to read as a clean
  # machine, so the two are told apart by what pkgutil actually said.
  # [LAW:no-silent-failure]
  case "$status:$out" in
    0:*)                echo "$out" | sed -n 's/^version: //p' ;;
    *"No receipt for"*) echo none ;;
    *)                  probe_failure "pkgutil could not read the receipt for $id (exit $status): $out" ;;
  esac
}

# The receipt id when the machine holds one and nothing when it does not, so removal
# runs over a collection instead of around a condition.
# [LAW:dataflow-not-control-flow]
#
# A receipt that could not be read is neither of those answers and is forwarded as the
# sentinel rather than collapsed into "present", which would have `remove` forget a
# receipt on the strength of a reading nobody took. [LAW:no-silent-failure]
receipts_present() {
  case "$(receipt_version "$BUNDLE_ID")" in
    none)         ;;
    probe-failed) echo probe-failed ;;
    *)            echo "$BUNDLE_ID" ;;
  esac
}

# Whether the driver has matched and published its node in the IORegistry. This is
# loading, not enabling: the extension can be enabled and still absent here until
# some client opens it.
io_node_present() {
  local out status
  out=$(ioreg -r -n "$IO_NODE" -d 1) && status=0 || status=$?
  if (( status != 0 )); then
    probe_failure "could not query the IORegistry for $IO_NODE (ioreg exit $status)"
    return 0
  fi
  [[ -n ${out//[[:space:]]/} ]] && echo yes || echo no
}

# ---------------------------------------------------------------------------
# The verdict
# ---------------------------------------------------------------------------

# One word for the whole machine, derived from the four facts and composed into a key
# so the mapping reads as a table to check against rather than a chain of conditions
# to simulate. The default arm names the key it could not place, which is the
# difference between a bug report and a mystery.
verdict_for() {
  local files=$1 receipt=$2 reg=$3 io=$4
  local held=yes

  # A probe that could not read the machine says so, and that answer is never blended
  # into a verdict about the driver. The reason is already on stderr; this only keeps
  # the unread fact from being reported as a fact. [LAW:no-silent-failure]
  case "$files $receipt $reg $io" in
    *probe-failed*) echo unknown; return 0 ;;
  esac

  [[ $receipt == none ]] && held=no

  case "files=$files;receipt=$held;reg=$reg;io=$io" in
    'files=none;receipt=no;reg=unregistered;io=no')   echo absent ;;
    'files=both;receipt=yes;reg=unregistered;io=no')  echo installed-inactive ;;
    'files=both;receipt=yes;reg=waiting;io=no')       echo awaiting-approval ;;
    'files=both;receipt=yes;reg=disabled;io=no')      echo disabled ;;
    'files=both;receipt=yes;reg=enabled;io=no')       echo enabled ;;
    'files=both;receipt=yes;reg=enabled;io=yes')      echo running ;;
    # Removal finished. Spelled as a whole key rather than matched on the registration
    # alone: `remove` reads this verdict as "nothing left to do", and a machine still
    # holding a payload or a receipt is `residue`, not this.
    'files=none;receipt=no;reg=pending-reboot;io=no') echo pending-reboot ;;
    # A registration this script cannot name, or two live ones at once. Kept apart
    # from `residue` because residue is a mess we understand and this is not.
    *'reg=unknown'*|*'reg=ambiguous'*)                echo unknown ;;
    *)                                                echo residue ;;
  esac
}

report_state() {
  local files receipt reg io result
  files=$(installed_files)
  receipt=$(receipt_version "$BUNDLE_ID")
  reg=$(dext_registration)
  io=$(io_node_present)
  result=$(verdict_for "$files" "$receipt" "$reg" "$io")

  {
    echo "pinned package     $PKG_VERSION (driver extension $DEXT_VERSION)"
    echo "payload on disk    $files"
    echo "installer receipt  $receipt"
    echo "extension state    $reg"
    echo "IORegistry node    $io"
    echo "verdict            $result"
  } >&2

  echo "$result"
}

# ---------------------------------------------------------------------------
# The verbs
# ---------------------------------------------------------------------------

cmd_state() {
  local result
  result=$(report_state)
  echo "$result"
  # Exit non-zero when a probe could not read the machine. `state` succeeds when it has
  # taken a reading; claiming success for a reading it never took is the one thing it
  # must not do, and a caller testing this command deserves to hear about it.
  [[ $result != unknown ]]
}

cmd_expect() {
  local want=${1:?usage: virtual-hid-driver expect <verdict>}
  local got
  got=$(report_state)
  [[ $got == "$want" ]] || die "expected the driver to be '$want' but it is '$got'"
  echo "virtual-hid-driver: confirmed '$want'" >&2
}

cmd_install() {
  local pkg result signature scratch_owner

  # The scratch path is fixed and its parent is shared, and `sudo installer` re-reads
  # the package after the checksum and signature have already passed. A local attacker
  # holding this directory could swap the bytes in that gap and be installed as root,
  # so the directory is proven ours and narrowed before anything is written into it.
  # Ownership is read before `chmod` on purpose: chmod on somebody else's directory
  # fails, and under `set -e` that aborts with no sentence naming who owns it.
  # [LAW:no-silent-failure]
  mkdir -p "$VHID_SCRATCH"
  scratch_owner=$(stat -f '%u' "$VHID_SCRATCH") \
    || die "could not read the ownership of $VHID_SCRATCH"
  [ "$scratch_owner" = "$(id -u)" ] \
    || die "$VHID_SCRATCH is owned by uid $scratch_owner and not by you, so nothing downloaded into it can be trusted; remove it, or set TMPDIR and run again"
  chmod 700 "$VHID_SCRATCH"

  pkg="$VHID_SCRATCH/driver.pkg"

  # Clear the previous run's package before fetching. A download that dies partway
  # would otherwise leave an older file sitting here for the checksum below to approve,
  # and this would install the wrong bytes while reporting success.
  # [LAW:no-silent-failure]
  rm -f "$pkg"

  echo "==> downloading $PKG_URL" >&2
  curl --fail --show-error --silent --location --output "$pkg" "$PKG_URL"

  # [LAW:no-silent-failure] Three lies get caught here, and the last two are one report
  # read twice. The checksum catches bytes that are not the pinned release, a moved tag
  # included. The status line catches an untrusted chain and the authority catches the
  # wrong signer: pkgutil prints a Common Name whether or not the chain behind it is
  # trusted, so a forged self-signed certificate survives either check taken alone.
  echo "$PKG_SHA256  $pkg" | shasum -a 256 --check --status \
    || die "the downloaded package does not match the checksum pinned for $PKG_VERSION"
  # Captured rather than piped, so pkgutil's own refusal is its exit status and not a
  # discarded one. Without the die it would abort under `set -e` holding the reason.
  signature=$(pkgutil --check-signature "$pkg") \
    || die "pkgutil refused the downloaded package: $signature"
  echo "$signature" | grep -qxF "$TRUSTED_STATUS" \
    || die "the downloaded package has no signature macOS trusts; pkgutil did not report '$TRUSTED_STATUS'"
  echo "$signature" | grep -qF "$SIGNING_AUTHORITY" \
    || die "the downloaded package is not signed by '$SIGNING_AUTHORITY'"

  echo "==> installing (sudo)" >&2
  sudo installer -pkg "$pkg" -target /

  echo "==> activating the driver extension" >&2
  "$MANAGER" activate

  # The Manager exits 0 even when handed a bare usage error, so its exit status proves
  # nothing at all and the state probe is the only honest report. [LAW:verifiable-goals]
  result=$(report_state)
  case "$result" in
    enabled|running) echo "virtual-hid-driver: the driver is active." >&2 ;;
    awaiting-approval|disabled)
      cat >&2 <<INSTRUCTION

virtual-hid-driver: the driver is installed and waiting for you.

  Open  System Settings > General > Login Items & Extensions
  Click the (i) beside "Driver Extensions"
  Turn ON  $BUNDLE_ID
  Authenticate when macOS asks

Then confirm with:  scripts/virtual-hid-driver expect enabled
INSTRUCTION
      exit 2 ;;
    # The package is on disk but macOS holds no registration for it, so the request
    # never landed. True whether the Manager refused it or the listing has not caught
    # up yet, which is why this says what was read rather than guessing which.
    installed-inactive)
      die "the package installed but macOS holds no registration for $BUNDLE_ID, so the activation request did not take; run 'install' again" ;;
    *) die "after installing, the driver is '$result', which is not a state installing can leave behind" ;;
  esac
}

# What `remove` says about a machine standing in one of the two states removal can end
# in. Shared by the early exit and the closing report, so the two cannot come to
# describe the same state differently. [LAW:one-source-of-truth]
#
# Every arm is terminal, which is what lets the call read the same in both positions.
remove_outcome() {
  case "$1" in
    absent)
      echo "virtual-hid-driver: the driver is gone." >&2
      exit 0 ;;
    pending-reboot)
      cat >&2 <<'INSTRUCTION'

virtual-hid-driver: the files and the receipt are gone, but macOS keeps the
extension registered as "terminated waiting to uninstall on reboot" until the
machine restarts. That entry is not a failure, and nothing else clears it.

  Restart the Mac

Then confirm with:  scripts/virtual-hid-driver expect absent
INSTRUCTION
      exit 2 ;;
    *) die "after removal, the driver is '$1', which is not a state removing can leave behind" ;;
  esac
}

cmd_remove() {
  local id receipts result registered withdrawn elements

  # A machine already at the end of removal has nothing left to withdraw, and the
  # Manager that would do the withdrawing is the thing removal deletes. Reading the
  # state first is what lets a second `remove` say where the machine actually stands,
  # instead of demanding a reinstall to reach a state it is already in.
  result=$(report_state)
  case "$result" in
    absent|pending-reboot) remove_outcome "$result" ;;
  esac

  # Karabiner-Elements ships this same driver and shares the Manager app, the support
  # directory and the receipt id, so everything below would take it down with it. The
  # refusal comes before the deactivation as well as before the deletion, because
  # withdrawing the extension already stops the driver Karabiner-Elements is using.
  #
  # A receipt that could not be read refuses too. "I could not tell" is not "it is not
  # installed", and this is the one verb whose mistake cannot be walked back.
  # [LAW:no-silent-failure]
  elements=$(receipt_version "$ELEMENTS_RECEIPT")
  case "$elements" in
    none) ;;
    probe-failed) die "could not tell whether $ELEMENTS_RECEIPT is installed, and removal deletes files the two products share; refusing to guess" ;;
    *) die "Karabiner-Elements $elements is installed and shares $MANAGER_APP and $SUPPORT_DIR with the driver package, so removing the driver would break it and nothing here could put it back; remove Karabiner-Elements first if that is what you want" ;;
  esac

  # [LAW:no-ambient-temporal-coupling] Deactivation must precede file removal, and the
  # order is not a preference. Only the Manager can withdraw the extension, and
  # removing the files deletes the Manager; do it the other way round and the
  # registration is stranded with nothing left on the machine able to retract it.
  # Only a live registration needs withdrawing, and only the withdrawal needs the
  # Manager. An extension already retired has nothing to do here, which is what lets a
  # `remove` interrupted after the files were deleted come back and finish the receipt
  # instead of being sent to reinstall the package first.
  # [LAW:dataflow-not-control-flow]
  registered=$(dext_registration)
  case "$registered" in
    unregistered|pending-reboot) ;;
    probe-failed) die "could not read whether the extension is still registered, and deleting the Manager while it is would strand the registration with nothing able to retract it; refusing to guess" ;;
    *)
      echo "==> deactivating the driver extension" >&2
      [[ -x $MANAGER ]] || die "the extension is registered as '$registered' but $MANAGER is missing, so nothing here can withdraw it; reinstall the package, then run 'remove'"
      "$MANAGER" deactivate

      # The Manager prints "request ... is failed" and still exits 0, so the withdrawal
      # is confirmed against the registration itself and never against that exit
      # status. Deleting the files while the extension is still registered is the one
      # ordering mistake this verb can make, and it is unrecoverable without
      # reinstalling, so it is checked here rather than trusted.
      # [LAW:no-ambient-temporal-coupling]
      withdrawn=$(dext_registration)
      case "$withdrawn" in
        pending-reboot|unregistered) ;;
        # A sentinel is not a registration state: reporting it as one sends an operator
        # after a stuck registration that may not exist. [LAW:no-silent-failure]
        probe-failed) die "could not confirm the extension was withdrawn because its registration could not be read; refusing to delete the Manager that is the only thing able to withdraw it" ;;
        *) die "the extension is still registered as '$withdrawn' after deactivation; refusing to delete the Manager that is the only thing able to withdraw it" ;;
      esac ;;
  esac

  echo "==> removing files (sudo)" >&2
  sudo rm -rf "$MANAGER_APP" "$SUPPORT_DIR"

  # What the package's own uninstall scripts leave behind. `pkgutil --forget` fails on
  # a receipt that is not there, so the receipts are read first and the removal runs
  # over what was actually found. Read in the main shell rather than piped into the
  # loop: a subshell is a place where neither the refusal below nor a failing `forget`
  # could stop the verb. [LAW:no-silent-failure]
  receipts=$(receipts_present)
  case "$receipts" in
    probe-failed) die "the installer receipt for $BUNDLE_ID could not be read, so whether to forget it is unknown; the payload is already deleted, and re-running 'remove' once the cause is fixed will finish the job" ;;
  esac
  for id in $receipts; do
    echo "==> forgetting installer receipt $id (sudo)" >&2
    sudo pkgutil --forget "$id"
  done

  remove_outcome "$(report_state)"
}

case "${1:-}" in
  state)   cmd_state ;;
  expect)  shift; cmd_expect "$@" ;;
  install) cmd_install ;;
  remove)  cmd_remove ;;
  *) die "usage: virtual-hid-driver state|expect <verdict>|install|remove" ;;
esac
