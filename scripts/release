#!/usr/bin/env bash
# The whole release, in the order Gatekeeper needs it: the app signed with its model inside,
# notarized and stapled, then put into a disk image that is signed, notarized and stapled
# itself.
#
#   NOTARY_PROFILE=<profile> scripts/release <output directory> [model source]
#     # prints <output directory>/LowTalker.dmg; LowTalker.app is left beside it
#
# The app is stapled before it goes into the image because the ticket has to travel with the
# app out of the image, and an image cannot be changed once it is signed. The model source is
# scripts/sign-release's.
#
# [LAW:composability] Each step is its own script, runnable alone; this one only orders them.
set -euo pipefail

out=${1:?usage: NOTARY_PROFILE=<profile> scripts/release <output directory> [model source]}
profile=${NOTARY_PROFILE:?NOTARY_PROFILE names the notarytool keychain profile; make one with xcrun notarytool store-credentials}
# Asked before the build, which takes minutes, rather than after it.
xcrun notarytool history --keychain-profile "$profile" >/dev/null \
  || { echo "release: the notarytool profile '$profile' does not answer" >&2; exit 1; }

# A release whose build number did not rise is one no updater or crash report can tell from
# the last. project.yml's CURRENT_PROJECT_VERSION counts releases and is raised by hand, so
# the Nth release is build N: it must exceed the number of release tags already on origin,
# of every version. A tag's own suffix is no substitute, since alpha, beta and rc each count
# again from 1. Read from origin, not local tags, which a fresh clone may not have. Read off
# project.yml before the build, like the profile; the build fails a bundle that does not
# carry it. [LAW:no-silent-failure]
scripts=$(dirname "$0")
build=$(xcodegen dump --type json --spec "$scripts/../project.yml" | jq -er '.settings.base.CURRENT_PROJECT_VERSION')
[[ "$build" =~ ^[1-9][0-9]*$ ]] \
  || { echo "release: project.yml's CURRENT_PROJECT_VERSION is '$build', not a whole number above zero" >&2; exit 1; }
released=$(git -C "$scripts/.." ls-remote --tags --refs origin "v*" | wc -l | tr -d ' ')
if [ "$build" -le "$released" ]; then
  echo "release: this is build $build, but $released releases are already tagged; raise CURRENT_PROJECT_VERSION in project.yml" >&2
  exit 1
fi

app=$("$scripts/sign-release" "$@")
"$scripts/notarize" "$app" >&2
dmg=$("$scripts/make-dmg" "$app" "$out")
"$scripts/notarize" "$dmg" >&2
echo "$dmg"
