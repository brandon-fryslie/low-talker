#!/usr/bin/env python3
"""Writes the SBOM of what a release ships, read off the resolved build.

    scripts/sbom <output.cdx.json>

CycloneDX 1.6, one component per thing that reaches a user's Mac: every package
Package.resolved pins, the third-party code vendored inside those packages, and the model
the app loads (its weights and its tokenizer). Identity, URL, version and revision come
from Package.resolved, the checkouts under .build, and the CLI; sbom/rules.json holds
only what none of those can say - the license of each component, and which packages
carry code no manifest declares. [LAW:one-source-of-truth]

A component the rules do not know stops the run and names it, because a row missing from
an SBOM is believed. [LAW:no-silent-failure] The output carries no timestamp and no
serial number, so the same checkout writes the same bytes twice.

Run through `make sbom`, which resolves the packages and builds the CLI first.
"""
import hashlib
import json
import re
import subprocess
import sys
from pathlib import Path

repository = Path(__file__).resolve().parent.parent
rules_path = repository / "sbom" / "rules.json"
checkouts = repository / ".build" / "checkouts"
cli = repository / ".build" / "debug" / "lowtalker"


def fail(message):
    print(f"sbom: {message}", file=sys.stderr)
    sys.exit(1)


def sha256(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def license_entry(component, path, spdx):
    """The license id and the digest of the file it names, so the SBOM says which text
    the id stands for."""
    if not spdx:
        fail(f"{component}: rules.json gives no license")
    if not path.is_file():
        fail(f"{component}: license file {path.relative_to(repository)} is not in the checkout")
    return (
        [{"license": {"id": spdx}}],
        [
            {"name": "low-talker:license-file", "value": str(path.relative_to(checkouts))},
            {"name": "low-talker:license-file-sha256", "value": sha256(path)},
        ],
    )


def vendored_version(component, checkout, rule):
    """The version written into the vendored files, by the rule's expression: group 1 is
    the version, group 2 the revision when the files carry one, unless `as` composes it."""
    source = checkout / rule["file"]
    if not source.is_file():
        fail(f"{component}: version file {rule['file']} is not in the checkout")
    found = re.search(rule["match"], source.read_text(errors="replace"), re.MULTILINE)
    if not found:
        fail(f"{component}: {rule['file']} does not match {rule['match']!r}, so its version cannot be read")
    if "as" in rule:
        version = re.sub(r"\$(\d+)", lambda m: found.group(int(m.group(1))), rule["as"])
        return version, None
    return found.group(1), found.group(2) if found.re.groups >= 2 else None


def package_component(pin, rule):
    identity = pin["identity"]
    location = pin["location"]
    repo = location.rsplit("/", 1)[-1].removesuffix(".git")
    checkout = checkouts / repo
    if not checkout.is_dir():
        fail(f"{identity}: no checkout at {checkout.relative_to(repository)}; run `swift package resolve`")
    state = pin["state"]
    version = state.get("version")
    if not version:
        fail(f"{identity}: Package.resolved pins it by revision alone, with no version")
    host_path = re.sub(r"^https?://", "", location).removesuffix(".git")
    ref = f"pkg:swift/{host_path}@{version}"
    licenses, properties = license_entry(identity, checkout / rule["licenseFile"], rule.get("license"))
    component = {
        "type": "library",
        "bom-ref": ref,
        "name": repo,
        "version": version,
        "purl": ref,
        "licenses": licenses,
        "externalReferences": [{"type": "vcs", "url": location}],
        "properties": [{"name": "low-talker:revision", "value": state["revision"]}] + properties,
    }
    vendored = [vendored_component(identity, checkout, ref, v) for v in rule.get("vendored", [])]
    if vendored:
        component["components"] = sorted(vendored, key=lambda c: c["bom-ref"])
    return component


def vendored_component(identity, checkout, parent_ref, rule):
    name = f"{identity} vendors {rule['name']}"
    path = checkout / rule["path"]
    if not path.exists():
        fail(f"{name}: nothing at {rule['path']} in the checkout")
    version, revision = vendored_version(name, checkout, rule["version"])
    licenses, properties = license_entry(name, checkout / rule["licenseFile"], rule.get("license"))
    properties = [{"name": "low-talker:vendored-at", "value": rule["path"]}] + properties
    if revision:
        properties.insert(0, {"name": "low-talker:revision", "value": revision})
    return {
        "type": "library",
        "bom-ref": f"{parent_ref}#{rule['name']}",
        "name": rule["name"],
        "version": version,
        "licenses": licenses,
        "externalReferences": [{"type": "vcs", "url": rule["origin"]}],
        "properties": properties,
    }


def model_components(rules):
    """The model the CLI names as the default, which is the one the release carries and
    a launch loads where nothing names another. WhisperKit fetches its weights from the
    repo it names and picks the tokenizer's repo off the weights' config, so both repos
    are the rule's to state."""
    if not cli.is_file():
        fail(f"no CLI at {cli.relative_to(repository)}; run `make cli`")
    model = subprocess.run([str(cli), "model", "default"], capture_output=True, text=True, check=True).stdout.strip()
    if not model:
        fail("`lowtalker model default` printed nothing")
    rule = rules.get(model)
    if rule is None:
        fail(f"the default model is {model} and rules.json has no entry for it")
    components = []
    for part, kind in (("weights", "machine-learning-model"), ("tokenizer", "data")):
        entry = rule.get(part)
        if not entry or not entry.get("repo") or not entry.get("license"):
            fail(f"{model}: rules.json gives no repo and license for its {part}")
        # The weights are one folder of a repo holding many models, so the repo is their
        # group and the model their name; the tokenizer is a repo of its own.
        group, name = (entry["repo"], model) if part == "weights" else entry["repo"].split("/", 1)
        components.append({
            "type": kind,
            "bom-ref": f"huggingface.co/{entry['repo']}" + (f"/{model}" if part == "weights" else ""),
            "group": group,
            "name": name,
            "licenses": [{"license": {"id": entry["license"]}}],
            "externalReferences": [{"type": "distribution", "url": f"https://huggingface.co/{entry['repo']}"}],
            "properties": [{"name": "low-talker:model-part", "value": part}],
        })
    return components


def application():
    dump = subprocess.run(["xcodegen", "dump", "--type", "json"], cwd=repository, capture_output=True, text=True, check=True).stdout
    version = json.loads(dump).get("settings", {}).get("base", {}).get("MARKETING_VERSION")
    if not version:
        fail("project.yml sets no project-wide MARKETING_VERSION")
    return {"type": "application", "bom-ref": "lowtalker", "name": "LowTalker", "version": str(version)}


def main():
    if len(sys.argv) != 2:
        fail("usage: scripts/sbom <output.cdx.json>")
    output = Path(sys.argv[1])
    rules = json.loads(rules_path.read_text())
    pins = json.loads((repository / "Package.resolved").read_text())["pins"]

    pinned = {pin["identity"] for pin in pins}
    ruled = set(rules["packages"])
    for identity in sorted(pinned - ruled):
        fail(f"Package.resolved pins {identity}, and sbom/rules.json has no entry for it: its license has not been read")
    for identity in sorted(ruled - pinned):
        fail(f"sbom/rules.json has an entry for {identity}, which Package.resolved no longer pins")

    components = [package_component(pin, rules["packages"][pin["identity"]]) for pin in pins]
    components += model_components(rules["models"])
    components.sort(key=lambda c: c["bom-ref"])
    app = application()
    bom = {
        "bomFormat": "CycloneDX",
        "specVersion": "1.6",
        "version": 1,
        "metadata": {"component": app},
        "components": components,
        "dependencies": [{"ref": app["bom-ref"], "dependsOn": [c["bom-ref"] for c in components]}],
    }
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(bom, indent=2, sort_keys=True) + "\n")
    print(f"{output}: {len(components)} components, {sum(len(c.get('components', [])) for c in components)} vendored")


main()
