#!/usr/bin/env bash
# The shell-level contracts in scripts/virtual-hid-driver, exercised against a stubbed
# CLI.
#
# The decision logic this suite used to cover - the bracket text, the verdict table, the
# four probes - moved to Sources/DriverExtension, where every combination of readings is
# exercised rather than the dozen anyone thought to write down. What is left here is
# what is still shell: the wrappers that turn the CLI's exits into words, the sentinel
# those words carry, and the exit codes a caller scripts against.
#
# Nothing here touches the machine's driver. `lowtalker` is replaced by a stub that
# answers from environment variables, so no privileged or destructive command can run
# even if a guard under test were wrong. `install` and `remove` are never invoked.
#
# [LAW:behavior-not-structure] The assertions are on the contract: the words the verbs
# consume, the sentinel, and the exit codes. Nothing here pins an internal call shape.
#
# Held to bash 3.2 like the script it tests, so no arrays.
set -uo pipefail

SCRIPT="$(dirname "$0")/virtual-hid-driver"

# Sourcing runs the verb dispatch at the foot of the script, and `state` is the
# read-only one. Its exit status reports the machine, not this suite, so it is not the
# signal here - what has to be true is that the definitions arrived, and that is checked
# directly rather than inferred from it. [LAW:no-silent-failure]
sourced_status=0
# shellcheck source=/dev/null
source "$SCRIPT" state >/dev/null 2>&1 || sourced_status=$?
set +e
declare -f report_state >/dev/null && declare -f receipt_version >/dev/null \
  || { echo "virtual-hid-driver-test: sourcing $SCRIPT left its functions undefined (exit $sourced_status)" >&2; exit 1; }

# From here on every reading goes to a stub that answers from the environment, so the
# states this Mac cannot be put into are the ordinary case rather than the hard one.
STUB_DIR=$(mktemp -d) || { echo "virtual-hid-driver-test: could not make a scratch directory" >&2; exit 1; }
trap 'rm -rf "$STUB_DIR"' EXIT
LOWTALKER="$STUB_DIR/lowtalker"
cat > "$LOWTALKER" <<'STUB'
#!/usr/bin/env bash
# argv is `driver <verb> [argument]`, which is exactly what the script calls.
case "${2:-}" in
  state)        printf '%s\n' "$STUB_STATE";   exit "$STUB_STATE_STATUS" ;;
  registration) printf '%s\n' "$STUB_REG";     exit "$STUB_REG_STATUS" ;;
  receipt)      printf '%s\n' "$STUB_RECEIPT"; exit "$STUB_RECEIPT_STATUS" ;;
  *) echo "stub lowtalker: unexpected argv: $*" >&2; exit 64 ;;
esac
STUB
chmod +x "$LOWTALKER"
export STUB_STATE=running STUB_STATE_STATUS=0
export STUB_REG=enabled STUB_REG_STATUS=0
export STUB_RECEIPT= STUB_RECEIPT_STATUS=0

pass=0
fail=0

check() {
  local what=$1 want=$2 got=$3
  if [[ $got == "$want" ]]; then
    pass=$((pass + 1))
  else
    fail=$((fail + 1))
    echo "FAIL  $what" >&2
    echo "        want: $want" >&2
    echo "        got:  $got" >&2
  fi
}

check_contains() {
  local what=$1 needle=$2 hay=$3
  case "$hay" in
    *"$needle"*) pass=$((pass + 1)) ;;
    *) fail=$((fail + 1))
       echo "FAIL  $what" >&2
       echo "        wanted text containing: $needle" >&2
       echo "        got: $hay" >&2 ;;
  esac
}

# ---------------------------------------------------------------------------
# require_cli - the build proven present before any reading is attempted
# ---------------------------------------------------------------------------

# Checked in the main shell rather than inside a command substitution, which is the
# whole point of it: a missing build discovered down there would be swallowed.
( LOWTALKER="$STUB_DIR/not-built"; require_cli ) >/dev/null 2>&1
check "require_cli refuses a missing build" 1 "$?"
check_contains "require_cli names how to fix it" "make cli" \
  "$( ( LOWTALKER="$STUB_DIR/not-built"; require_cli ) 2>&1 )"
( require_cli ) >/dev/null 2>&1
check "require_cli accepts a build that is there" 0 "$?"

# ---------------------------------------------------------------------------
# report_state - one verdict word, whatever the CLI did
# ---------------------------------------------------------------------------

STUB_STATE=running STUB_STATE_STATUS=0
check "report_state yields the CLI's verdict" running "$(report_state 2>/dev/null)"

# The CLI prints `unknown` and exits 1 for a machine it could not read. That word is one
# every caller here already refuses on, so it is carried through rather than turned into
# a second way of saying the same thing.
STUB_STATE=unknown STUB_STATE_STATUS=1
check "report_state carries an unreadable machine through as unknown" unknown "$(report_state 2>/dev/null)"

# An empty answer would sail through every case arm below it into the fallthrough, so it
# becomes the one word that is always refused, and the reason is said out loud.
STUB_STATE= STUB_STATE_STATUS=1
check "report_state turns an empty answer into unknown" unknown "$(report_state 2>/dev/null)"
check_contains "report_state says the CLI printed no verdict" "printed no verdict" \
  "$(report_state 2>&1 >/dev/null)"
STUB_STATE=running STUB_STATE_STATUS=0

# The pinned package is what `install` would fetch rather than something read off this
# Mac, so it is this script's line and it belongs beside the CLI's own table.
check_contains "report_state prints the pinned package for a reader" "$PKG_VERSION" \
  "$(report_state 2>&1 >/dev/null)"

# ---------------------------------------------------------------------------
# cmd_state - the exit code a caller tests
# ---------------------------------------------------------------------------

STUB_STATE=running STUB_STATE_STATUS=0
( cmd_state ) >/dev/null 2>&1
check "cmd_state exits 0 on a reading it took" 0 "$?"
# `state` succeeds when it has taken a reading; claiming success for a reading it never
# took is the one thing it must not do.
STUB_STATE=unknown STUB_STATE_STATUS=1
( cmd_state ) >/dev/null 2>&1
check "cmd_state exits non-zero on a machine it could not read" 1 "$?"
STUB_STATE=running STUB_STATE_STATUS=0

# ---------------------------------------------------------------------------
# driver_registration - the one fact removal reasons about alone
# ---------------------------------------------------------------------------

STUB_REG=enabled STUB_REG_STATUS=0
check "driver_registration yields the CLI's word" enabled "$(driver_registration)"
STUB_REG=pending-reboot STUB_REG_STATUS=0
check "driver_registration yields a pending-reboot registration" pending-reboot "$(driver_registration)"
# Refusing to act on a reading nobody took is what keeps `remove` from deleting the
# Manager while the extension is still registered - the one ordering mistake it can make
# that nothing can walk back.
STUB_REG=unknown STUB_REG_STATUS=1
check "driver_registration forwards a failed reading as the sentinel" probe-failed "$(driver_registration)"
STUB_REG= STUB_REG_STATUS=0
check "driver_registration reads an empty answer as the sentinel" probe-failed "$(driver_registration)"
STUB_REG=enabled STUB_REG_STATUS=0

# ---------------------------------------------------------------------------
# receipt_version - a version, no receipt, or the sentinel
# ---------------------------------------------------------------------------

STUB_RECEIPT=8.4.0 STUB_RECEIPT_STATUS=0
check "receipt_version reads the version" 8.4.0 "$(receipt_version org.pqrs.test)"
# The CLI prints nothing for a Mac holding no such receipt, and that is a normal answer.
STUB_RECEIPT= STUB_RECEIPT_STATUS=0
check "receipt_version reads an absent receipt" none "$(receipt_version org.pqrs.test)"
# Anything the CLI could not read is not a clean machine, and the two must not arrive as
# one answer. [LAW:no-silent-failure]
STUB_RECEIPT= STUB_RECEIPT_STATUS=1
check "receipt_version forwards an unreadable receipt as the sentinel" probe-failed "$(receipt_version org.pqrs.test)"

# ---------------------------------------------------------------------------
# receipts_present - the receipt to forget, or nothing, or the sentinel
# ---------------------------------------------------------------------------

STUB_RECEIPT= STUB_RECEIPT_STATUS=0
check "receipts_present finds nothing to forget" "" "$(receipts_present)"
STUB_RECEIPT=8.4.0 STUB_RECEIPT_STATUS=0
check "receipts_present names the receipt" "$BUNDLE_ID" "$(receipts_present)"
# Collapsing the sentinel into "present" would have `remove` forget a receipt on the
# strength of a reading nobody took.
STUB_RECEIPT= STUB_RECEIPT_STATUS=1
check "receipts_present forwards the sentinel" probe-failed "$(receipts_present)"
STUB_RECEIPT= STUB_RECEIPT_STATUS=0

# ---------------------------------------------------------------------------
# remove_outcome - the exit codes a caller scripts against
# ---------------------------------------------------------------------------

# Run in subshells: every arm is terminal.
( remove_outcome absent ) >/dev/null 2>&1
check "remove_outcome absent exits 0" 0 "$?"
( remove_outcome pending-reboot ) >/dev/null 2>&1
check "remove_outcome pending-reboot exits 2" 2 "$?"
# A state removal cannot end in is a refusal, not a success with a caveat.
( remove_outcome residue ) >/dev/null 2>&1
check "remove_outcome refuses an unfinished state" 1 "$?"

# ---------------------------------------------------------------------------

echo "virtual-hid-driver-test: $pass passed, $fail failed" >&2
[ "$fail" -eq 0 ]
