#!/bin/bash
# Renders the icons the bundles carry from their sources in App/Icons. The PNGs and the
# TIFF are this script's output, checked in so a build needs no rsvg-convert; change the
# SVG and run this, never the rendered files. Needs rsvg-convert (brew install librsvg).
set -euo pipefail

cd "$(dirname "$0")/.."
catalog=App/LowTalker/Assets.xcassets
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

set="$catalog/AppIcon.appiconset"
rm -rf "$set"
mkdir -p "$set"
for size in 16 32 128 256 512; do
    rsvg-convert -w "$size" App/Icons/AppIcon.svg -o "$set/icon_$size.png"
    rsvg-convert -w $((size * 2)) App/Icons/AppIcon.svg -o "$set/icon_$size@2x.png"
done
{
    echo '{'
    echo '  "images" : ['
    for size in 16 32 128 256 512; do
        echo "    { \"idiom\" : \"mac\", \"size\" : \"${size}x$size\", \"scale\" : \"1x\", \"filename\" : \"icon_$size.png\" },"
        comma=,; [ "$size" = 512 ] && comma=
        echo "    { \"idiom\" : \"mac\", \"size\" : \"${size}x$size\", \"scale\" : \"2x\", \"filename\" : \"icon_$size@2x.png\" }$comma"
    done
    echo '  ],'
    echo '  "info" : { "author" : "xcode", "version" : 1 }'
    echo '}'
} >"$set/Contents.json"

# The Input menu's glyph: a template image, one 16 pt TIFF carrying its 1x and 2x.
rsvg-convert -w 16 App/Icons/InputMethod.svg -o "$scratch/glyph.png"
rsvg-convert -w 32 App/Icons/InputMethod.svg -o "$scratch/glyph@2x.png"
tiffutil -cathidpicheck "$scratch/glyph.png" "$scratch/glyph@2x.png" -out App/InputMethods/InputMethod.tiff >/dev/null

# The menu bar's mark, drawn twice by hand: the 1x on whole pixels, since a half-pixel
# edge at 1x is a grey smear.
set="$catalog/StatusMark.imageset"
rm -rf "$set"
mkdir -p "$set"
rsvg-convert -w 18 App/Icons/Status@1x.svg -o "$set/mark@1x.png"
rsvg-convert -w 36 App/Icons/Status.svg -o "$set/mark@2x.png"
cat >"$set/Contents.json" <<'JSON'
{
  "images" : [
    { "idiom" : "universal", "scale" : "1x", "filename" : "mark@1x.png" },
    { "idiom" : "universal", "scale" : "2x", "filename" : "mark@2x.png" }
  ],
  "info" : { "author" : "xcode", "version" : 1 },
  "properties" : { "template-rendering-intent" : "template" }
}
JSON
