#!/bin/bash
# Renders the icons the bundles carry from their sources in App/Icons. The PNGs and the
# TIFF are this script's output, checked in so a build needs no rsvg-convert; change the
# SVG and run this, never the rendered files. Needs rsvg-convert (brew install librsvg).
set -euo pipefail

cd "$(dirname "$0")/.."
catalog=App/LowTalker/Assets.xcassets
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

# Dev is the release artwork in amber: one source for the shapes, so they cannot drift.
cp App/Icons/AppIcon.svg "$scratch/AppIcon.svg"
sed -e 's/#4B3FD1/#F29A2E/; s/#1E1A5E/#B4501A/; s/#5B4FE6/#E8862A/; s/#2C2585/#A8461A/; s/#0B0930/#4A1E08/' \
    App/Icons/AppIcon.svg >"$scratch/AppIconDev.svg"

for name in AppIcon AppIconDev; do
    set="$catalog/$name.appiconset"
    rm -rf "$set"
    mkdir -p "$set"
    for size in 16 32 128 256 512; do
        rsvg-convert -w "$size" "$scratch/$name.svg" -o "$set/icon_$size.png"
        rsvg-convert -w $((size * 2)) "$scratch/$name.svg" -o "$set/icon_$size@2x.png"
    done
    {
        echo '{'
        echo '  "images" : ['
        for size in 16 32 128 256 512; do
            echo "    { \"idiom\" : \"mac\", \"size\" : \"${size}x$size\", \"scale\" : \"1x\", \"filename\" : \"icon_$size.png\" },"
            comma=,; [ "$size" = 512 ] && comma=
            echo "    { \"idiom\" : \"mac\", \"size\" : \"${size}x$size\", \"scale\" : \"2x\", \"filename\" : \"icon_$size@2x.png\" }$comma"
        done
        echo '  ],'
        echo '  "info" : { "author" : "xcode", "version" : 1 }'
        echo '}'
    } >"$set/Contents.json"
done

# The Input menu's glyph: a template image, one 16 pt TIFF carrying its 1x and 2x.
rsvg-convert -w 16 App/Icons/InputMethod.svg -o "$scratch/glyph.png"
rsvg-convert -w 32 App/Icons/InputMethod.svg -o "$scratch/glyph@2x.png"
tiffutil -cathidpicheck "$scratch/glyph.png" "$scratch/glyph@2x.png" -out App/InputMethods/InputMethod.tiff >/dev/null

# The menu bar's mark, drawn twice by hand: the 1x on whole pixels, since a half-pixel
# edge at 1x is a grey smear. Dev carries a badge to its right, the release mark's shapes
# unchanged, so the two copies in one menu bar are told apart.
for name in StatusMark StatusMarkDev; do
    set="$catalog/$name.imageset"
    rm -rf "$set"
    mkdir -p "$set"
    for scale in 1 2; do
        source=App/Icons/Status.svg; [ "$scale" = 1 ] && source=App/Icons/Status@1x.svg
        if [ "$name" = StatusMarkDev ]; then
            # Widened to 23 so the badge clears the caret's serif by a whole pixel at 1x.
            width=23
            sed -e 's/viewBox="0 0 18 18"/viewBox="0 0 23 18"/' -e 's#</svg>#  <circle cx="21" cy="3" r="2"/>\n</svg>#' \
                "$source" >"$scratch/$name@$scale.svg"
            grep -q 'viewBox="0 0 23 18"' "$scratch/$name@$scale.svg" || { echo "$source: no 18x18 viewBox to widen" >&2; exit 1; }
        else
            width=18
            cp "$source" "$scratch/$name@$scale.svg"
        fi
        rsvg-convert -w $((width * scale)) "$scratch/$name@$scale.svg" -o "$set/mark@${scale}x.png"
    done
    cat >"$set/Contents.json" <<'JSON'
{
  "images" : [
    { "idiom" : "universal", "scale" : "1x", "filename" : "mark@1x.png" },
    { "idiom" : "universal", "scale" : "2x", "filename" : "mark@2x.png" }
  ],
  "info" : { "author" : "xcode", "version" : 1 },
  "properties" : { "template-rendering-intent" : "template" }
}
JSON
done
