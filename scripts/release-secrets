#!/usr/bin/env bash
# Checks the release credentials and sets them as this repository's secrets, which
# .github/workflows/release.yml reads to sign and notarize a tag's packages.
#
#   DEVELOPER_ID_P12_PASSWORD=<password> scripts/release-secrets <identities.p12> <AuthKey_<key id>.p8> <issuer id>
#
# The .p12 holds both Developer ID identities, Application and Installer, exported together
# from Keychain Access with the password given. The .p8 is an App Store Connect team API key
# with the Developer role, under the name App Store Connect downloads it as, which carries
# its key id; the issuer id is shown above the key list.
#
# Every credential is proved before any secret is set, so the workflow does not learn of a
# wrong one twenty minutes into a release.
set -euo pipefail

usage="usage: DEVELOPER_ID_P12_PASSWORD=<password> scripts/release-secrets <identities.p12> <AuthKey_<key id>.p8> <issuer id>"
p12=${1:?$usage}
key=${2:?$usage}
issuer=${3:?$usage}
password=${DEVELOPER_ID_P12_PASSWORD:?$usage}
source "$(dirname "$0")/developer-id"

fail() {
  echo "release-secrets: $1" >&2
  exit 1
}

key_id=$(basename "$key")
[[ "$key_id" =~ ^AuthKey_([A-Z0-9]+)\.p8$ ]] || fail "$key is not named AuthKey_<key id>.p8"
key_id=${BASH_REMATCH[1]}

# Imported into a keychain of its own, which is what the workflow does with it, and deleted
# after, which also takes it off the search list.
scratch=$(mktemp -d "${TMPDIR:-/tmp}/lowtalker-secrets.XXXXXX")
keychain="$scratch/check.keychain-db"
trap 'security delete-keychain "$keychain" 2>/dev/null; rm -rf "$scratch"' EXIT
security create-keychain -p check "$keychain"
security import "$p12" -k "$keychain" -P "$password" >/dev/null \
  || fail "$p12 does not open with DEVELOPER_ID_P12_PASSWORD"
identities=$(security find-identity -v -p basic "$keychain")
for kind in Application Installer; do
  grep -qF "\"Developer ID $kind: $developer_id\"" <<<"$identities" \
    || fail "$p12 holds no valid Developer ID $kind identity for $developer_id; it holds: $identities"
done

xcrun notarytool history --key "$key" --key-id "$key_id" --issuer "$issuer" >/dev/null \
  || fail "the notary service refuses API key $key_id with issuer $issuer"

# The script's own repository, not the one the shell happens to be in.
repo=$(cd "$(dirname "$0")" && gh repo view --json nameWithOwner --jq .nameWithOwner)
base64 -i "$p12" | gh secret set --repo "$repo" DEVELOPER_ID_P12
gh secret set --repo "$repo" DEVELOPER_ID_P12_PASSWORD <<<"$password"
gh secret set --repo "$repo" NOTARY_API_KEY < "$key"
gh secret set --repo "$repo" NOTARY_API_KEY_ID <<<"$key_id"
gh secret set --repo "$repo" NOTARY_API_ISSUER <<<"$issuer"
