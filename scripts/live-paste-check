#!/bin/bash
# Pastes into TextEdit and Terminal with `lowtalker paste` and checks what landed,
# without AppleScript: Automation prompts cannot be answered by an unattended shell and
# a timed-out prompt writes a denial. `open -a` brings the app forward, the focused
# element's text is read through Accessibility, and each window the check opened is
# closed through its own close button. Needs an unlocked screen and a terminal with
# Accessibility. Leaves the pasteboard and the frontmost app as found.
set -euo pipefail

cd "$(dirname "$0")/.."
swift build --product lowtalker >/dev/null
CLI=.build/debug/lowtalker

# Read back through scripts/live-probe, the probe scripts/live-type-check shares. Built
# under .build so a rerun rebuilds only what changed.
swift build --package-path scripts/live-probe --scratch-path .build/live-probe >/dev/null
PROBE=.build/live-probe/debug/probe

[ "$($PROBE locked)" = unlocked ] || { echo "screen is locked; nothing can receive a paste" >&2; exit 1; }
front=$($PROBE front)
scratch=$(mktemp -d)
doc="$scratch/live-paste.txt"
reader="$scratch/reader.command"
terminal_was_running=$(pgrep -x Terminal >/dev/null && echo yes || echo no)
# Every path out closes what the check opened, whichever step it stopped at, and then
# puts the desk back as found. errexit stays off inside: each step reports its own
# failure and the rest still run.
cleanup() {
    set +e
    $PROBE close com.apple.TextEdit "${doc##*/}" 5
    $PROBE close com.apple.Terminal "${reader##*/}" 5
    [ "$terminal_was_running" = yes ] || $PROBE quit com.apple.Terminal
    rm -rf "$scratch"
    open -b "$front"
}
trap cleanup EXIT
before=$($PROBE pasteboard)
echo "frontmost before: $front"

# TextEdit: a file-backed .txt document, which TextEdit writes when its window closes,
# so the file is the verdict and no chord is posted.
: > "$doc"
open -a TextEdit "$doc"; $PROBE ready com.apple.TextEdit 10
$CLI paste "hello from low-talker into TextEdit"
focused=$($PROBE axwait "hello from low-talker into TextEdit" 3 && echo "held the text" || echo "never held the text")
$PROBE close com.apple.TextEdit "${doc##*/}" 5
t0=$SECONDS
until grep -q "hello from low-talker into TextEdit" "$doc" || [ $((SECONDS - t0)) -ge 5 ]; do sleep 0.1; done
grep -q "hello from low-talker into TextEdit" "$doc" && echo "TEXTEDIT OK (saved file holds the text)" || { echo "TEXTEDIT FAILED: focused element $focused; saved file holds [$(cat "$doc")]"; exit 1; }

# Terminal: a script file opens a new window that runs the check's own reader, tr, so
# the paste touches nothing that was open before and no shell runs what lands: the
# inserter under test may paste the wrong text. The check waits for the reader's
# marker, the state that says the login shell has finished starting; before that,
# the pty echoes typed text that the shell then drops. The echo of the pasted text
# is Terminal writing it to the pty, which is the paste landing; tr answers only in
# uppercase, so lowercase text in the window is that echo and nothing else.
printf '#!/bin/sh\necho lowtalker-reader-up; exec tr a-z A-Z\n' > "$reader"; chmod +x "$reader"
open -a Terminal "$reader"; $PROBE ready com.apple.Terminal 10; $PROBE axwait lowtalker-reader-up 15
$CLI paste "pasted-into-terminal-ok"
$PROBE axwait pasted-into-terminal-ok 3 && echo "TERMINAL OK" || { echo "TERMINAL FAILED"; exit 1; }

after=$($PROBE pasteboard)
[ "$before" = "$after" ] && echo "PASTEBOARD UNCHANGED" || { printf 'PASTEBOARD DIFFERS\nbefore:\n%s\nafter:\n%s\n' "$before" "$after"; exit 1; }
