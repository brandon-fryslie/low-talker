#!/usr/bin/env python3
"""Watches a built app on the wire through a launch and a dictation, and passes only if it
opened no connection.

    scripts/wire-check <app bundle>
    scripts/wire-check judge <capture> <process name>

The app links WhisperKit and the Hugging Face hub client vendored in argmax-oss-swift, code
that can reach the network and that nobody here wrote. sbom/rules.json records the revision
of that package this was last run against, and scripts/sbom stops the build on any other, so
a bump of it is re-checked here rather than believed. [LAW:no-silent-failure]

The first form quits the app, starts `log stream` on its processes (the app and its input
method, whose names both begin with the app's executable name), relaunches it, and waits for
one dictation: hold the chord, speak, release. Every connection a process opens through
URLSession or Network.framework logs under com.apple.network's `connection` category or
com.apple.CFNetwork, whatever proxy it would or would not honour. A path evaluation - asking
whether a route exists, which the hub client's NWPathMonitor does as the tokenizer loads -
logs under `path` and opens nothing, so it is counted and not failed.

An empty capture proves nothing if the stream itself was blind, so the run makes one request
of its own with nscurl inside the same capture, and the judge fails unless it sees that one.

The second form judges a capture already taken: the first form writes one and then runs it.
"""
import plistlib
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

CONTROL = "nscurl"
CONTROL_URL = "https://example.com"
# `log stream --style compact`: date, time, type, then Process[pid:tid] and [subsystem:category].
LINE = re.compile(r"^\S+ \S+ \S+\s+(?P<process>.+?)\[\d+:[0-9a-f]+\] \[(?P<subsystem>[^:\]]*):?(?P<category>[^\]]*)\] (?P<message>.*)$")


def fail(message):
    print(f"wire-check: {message}", file=sys.stderr)
    sys.exit(1)


def is_connection(subsystem, category):
    return subsystem.startswith("com.apple.CFNetwork") or (subsystem == "com.apple.network" and category == "connection")


def judge(capture, name):
    """The verdict on one capture, from its lines alone. Returns the summary of a pass."""
    connections, paths, dictations, ready = [], 0, 0, False
    control = 0
    for line in capture.read_text(errors="replace").splitlines():
        found = LINE.match(line)
        if not found:
            continue
        process, subsystem, category, message = found.group("process", "subsystem", "category", "message")
        if process == CONTROL:
            control += is_connection(subsystem, category)
            continue
        if not process.startswith(name):
            continue
        if is_connection(subsystem, category):
            connections.append(line)
        elif subsystem == "com.apple.network" and category == "path" and "nw_path_evaluator_start" in message:
            paths += 1
        # AppDelegate's engine readout and Dictation's summary of a finished dictation.
        elif message.startswith("model: ready"):
            ready = True
        elif message.startswith("heard "):
            dictations += 1
    if not control:
        fail(f"{capture} holds no connection from the {CONTROL} control, so the stream saw nothing and its silence proves nothing")
    if connections:
        fail(f"{name} opened connections; the first of {len(connections)} lines:\n" + "\n".join(connections[:5]))
    if not ready:
        fail(f"{capture} never shows {name} reporting its model ready, so the load was not watched")
    if not dictations:
        fail(f"{capture} holds no dictation by {name}, so a dictation was not watched")
    return f"{name}: no connection through a launch and {dictations} dictation(s); {paths} path evaluation(s), which open none"


def bundle_info(app):
    plist = app / "Contents" / "Info.plist"
    if not plist.is_file():
        fail(f"{app} is not an app bundle: no {plist}")
    info = plistlib.loads(plist.read_bytes())
    return info["CFBundleIdentifier"], info["CFBundleExecutable"]


def wait_for(capture, predicate, what, seconds):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if predicate(capture.read_text(errors="replace")):
            return
        time.sleep(0.5)
    fail(f"gave up after {seconds} s waiting for {what}; the capture so far is {capture}")


def watch(app):
    bundle_id, name = bundle_info(app)
    capture = Path(tempfile.mkdtemp(prefix="wire-check.")) / "capture.log"
    predicate = (f'(process BEGINSWITH "{name}" OR process == "{CONTROL}") AND '
                 f'(subsystem BEGINSWITH "com.apple.network" OR subsystem BEGINSWITH "com.apple.CFNetwork" OR subsystem == "{bundle_id}")')
    with capture.open("w") as out:
        stream = subprocess.Popen(["/usr/bin/log", "stream", "--level", "debug", "--style", "compact", "--predicate", predicate],
                                  stdout=out, stderr=subprocess.STDOUT)
    try:
        wait_for(capture, lambda text: "Timestamp" in text, "log stream to start", 30)
        subprocess.run(["/usr/bin/nscurl", "-o", "/dev/null", CONTROL_URL], check=True, capture_output=True)
        subprocess.run(["/usr/bin/pkill", "-TERM", "-x", name])
        wait_for(capture, lambda _: subprocess.run(["/usr/bin/pgrep", "-x", name], capture_output=True).returncode != 0,
                 f"{name} to quit", 30)
        subprocess.run(["/usr/bin/open", "-g", str(app)], check=True)
        wait_for(capture, lambda text: f"] [{bundle_id}:engine] model: ready" in text, f"{name} to load its model", 600)
        print(f"wire-check: {name} is ready; dictate once now: hold the chord, speak, release", flush=True)
        wait_for(capture, lambda text: f"] [{bundle_id}:dictation] heard " in text, "a dictation", 600)
        time.sleep(2)
    finally:
        stream.terminate()
        stream.wait()
    return capture, name


def main():
    if len(sys.argv) == 4 and sys.argv[1] == "judge":
        capture, name = Path(sys.argv[2]), sys.argv[3]
    elif len(sys.argv) == 2:
        capture, name = watch(Path(sys.argv[1]).resolve())
    else:
        fail("usage: scripts/wire-check <app bundle> | scripts/wire-check judge <capture> <process name>")
    print(f"wire-check: {judge(capture, name)}; capture at {capture}")


main()
