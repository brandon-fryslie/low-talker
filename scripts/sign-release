#!/usr/bin/env bash
# Builds LowTalker.app to hand to someone else, and proves its signature is one the notary
# service accepts, on the app and on the keyboard helper embedded in it.
#
#   scripts/sign-release <output directory> [model source]    # prints <output directory>/LowTalker.app
#
# The bundle carries the default model in Contents/Resources/model-store, so a first launch
# installs it with the network off. The model source is what `lowtalker model download
# --from` takes: a store holding the model, such as ~/Library/Application Support/low-talker/hub,
# or a base URL serving the archive `lowtalker model pack` writes. With none, the model comes
# from Hugging Face.
#
# The build is `make release` in the Release configuration, which project.yml signs with the
# Developer ID identity, Hardened Runtime and a secure timestamp. It goes into a derived-data
# directory made for this run and removed after it: an incremental build keeps embedding a
# helper whose only change is its signature (low-build-mmp), so a warm DerivedData could hand
# over a bundle whose helper is signed by the dev identity.
#
# [LAW:one-source-of-truth] The recipe is the Makefile's and the identity and team are
# project.yml's; this script only chooses the configuration and reads the result back.
set -euo pipefail

out=${1:?usage: scripts/sign-release <output directory> [model source]}
source=${2:-}
# Made and resolved before the move to the repo root, which make and xcodegen need, so a
# relative directory means the one the caller named.
mkdir -p "$out"
out=$(cd "$out" && pwd)
if [ -d "$source" ]; then source=$(cd "$source" && pwd); fi
cd "$(dirname "$0")/.."

derived=$(mktemp -d "${TMPDIR:-/tmp}/lowtalker-release.XXXXXX")
trap 'rm -rf "$derived"' EXIT

# The CLI decides which model is the default and installs it whole, manifests and all, so
# this script names neither. [LAW:one-source-of-truth]
cli=$(make cli | tee /dev/stderr | tail -n 1)
carried="$derived/model-store"
"$cli" model download --models-dir "$carried" ${source:+--from "$source"} >&2

make release CONFIGURATION=Release DERIVED_DATA="$derived" BUNDLED_MODEL_STORE="$carried" >&2

app="$out/LowTalker.app"
# Removed first: ditto merges into a bundle already there. [LAW:no-silent-failure]
rm -rf "$app"
ditto "$derived/Build/Products/Release/LowTalker.app" "$app"

team=$(xcodegen dump --type json | jq -er '.settings.configs.Release.DEVELOPMENT_TEAM // error("project.yml sets no DEVELOPMENT_TEAM for Release")')

fail() {
  echo "sign-release: $1" >&2
  exit 1
}

# What the notary service refuses, asked of one binary: no Developer ID signature from the
# team, no Hardened Runtime, no secure timestamp, or the get-task-allow entitlement.
check() {
  local binary=$1 signature entitlements
  signature=$(codesign -dvv "$binary" 2>&1)
  grep -qx "Authority=Developer ID Application: .* ($team)" <<<"$signature" \
    || fail "$binary is not signed with a Developer ID Application certificate for team $team"
  grep -qE '^CodeDirectory .*flags=0x[0-9a-f]+\([^)]*runtime' <<<"$signature" \
    || fail "$binary is not signed with Hardened Runtime"
  grep -q '^Timestamp=' <<<"$signature" \
    || fail "$binary has no secure timestamp"
  entitlements=$(codesign -d --entitlements - --xml "$binary" 2>/dev/null)
  ! grep -q 'com.apple.security.get-task-allow' <<<"$entitlements" \
    || fail "$binary carries com.apple.security.get-task-allow"
}

codesign --verify --deep --strict "$app" || fail "$app does not verify"
resource=$(xcodegen dump --type json | jq -er '.targetTemplates.Installation.settings.base.MODEL_STORE_RESOURCE // error("project.yml names no MODEL_STORE_RESOURCE")')
"$cli" model status --models-dir "$app/Contents/Resources/$resource" >&2 \
  || fail "$app does not carry the default model whole"
check "$app"
check "$app/Contents/MacOS/lowtalker-keyboardd"
echo "$app"
