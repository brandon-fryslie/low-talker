#!/usr/bin/env bash
# Builds LowTalker.app to hand to someone else, and proves its signature is one the notary
# service accepts, on the app and on everything embedded in it: the keyboard helper, the CLI
# and the input method bundle.
#
#   scripts/sign-release <output directory> [model source]    # prints <output directory>/LowTalker.app
#
# The bundle carries the default model in Contents/Resources/model-store, so a first launch
# loads it in place with the network off, and the pinned virtual keyboard driver package beside it,
# so installing the driver needs no GitHub. The model source is what `lowtalker model download
# --from` takes: a store holding the model, such as ~/Library/Application Support/low-talker/hub,
# or a base URL serving the archive `lowtalker model pack` writes. With none, the model comes
# from Hugging Face.
#
# The build is `make release` in the Release configuration, which project.yml signs with the
# Developer ID identity, Hardened Runtime and a secure timestamp. It goes into a derived-data
# directory made for this run and removed after it: an incremental build keeps embedding a
# helper whose only change is its signature (low-build-mmp), so a warm DerivedData could hand
# over a bundle whose helper is signed by the dev identity.
#
# [LAW:one-source-of-truth] The recipe is the Makefile's and the identity and team are
# project.yml's; this script only chooses the configuration and reads the result back.
set -euo pipefail

out=${1:?usage: scripts/sign-release <output directory> [model source]}
source=${2:-}
# Made and resolved before the move to the repo root, which make and xcodegen need, so a
# relative directory means the one the caller named.
mkdir -p "$out"
out=$(cd "$out" && pwd)
if [ -d "$source" ]; then source=$(cd "$source" && pwd); fi
cd "$(dirname "$0")/.."

derived=$(mktemp -d "${TMPDIR:-/tmp}/lowtalker-release.XXXXXX")
trap 'rm -rf "$derived"' EXIT

# The CLI decides which model is the default and installs it whole, manifests and all, so
# this script names neither. [LAW:one-source-of-truth] It fetches once here; `make release`
# then copies the store the bundle carries out of the fetched one by the same rule every
# build uses, so what the bundle carries is exactly what an install certifies.
cli=$(make cli | tee /dev/stderr | tail -n 1)
fetched="$derived/fetched-store"
"$cli" model download --models-dir "$fetched" ${source:+--from "$source"} >&2

# The CLI holds the pins and the checks, so it fetches the package it would install.
package=$("$cli" driver fetch "$derived")

make release CONFIGURATION=Release DERIVED_DATA="$derived" MODEL_SOURCE="$fetched" BUNDLED_DRIVER_PACKAGE="$package" >&2

app="$out/LowTalker.app"
# Removed first: ditto merges into a bundle already there. [LAW:no-silent-failure]
rm -rf "$app"
ditto "$derived/Build/Products/Release/LowTalker.app" "$app"

team=$(xcodegen dump --type json | jq -er '.settings.configs.Release.DEVELOPMENT_TEAM // error("project.yml sets no DEVELOPMENT_TEAM for Release")')

fail() {
  echo "sign-release: $1" >&2
  exit 1
}

# What the notary service refuses, asked of one binary: no Developer ID signature from the
# team, no Hardened Runtime, no secure timestamp, or the get-task-allow entitlement.
check() {
  local binary=$1 signature entitlements
  signature=$(codesign -dvv "$binary" 2>&1)
  grep -qx "Authority=Developer ID Application: .* ($team)" <<<"$signature" \
    || fail "$binary is not signed with a Developer ID Application certificate for team $team"
  grep -qE '^CodeDirectory .*flags=0x[0-9a-f]+\([^)]*runtime' <<<"$signature" \
    || fail "$binary is not signed with Hardened Runtime"
  grep -q '^Timestamp=' <<<"$signature" \
    || fail "$binary has no secure timestamp"
  entitlements=$(codesign -d --entitlements - --xml "$binary" 2>/dev/null)
  ! grep -q 'com.apple.security.get-task-allow' <<<"$entitlements" \
    || fail "$binary carries com.apple.security.get-task-allow"
}

codesign --verify --deep --strict "$app" || fail "$app does not verify"
resources=$(xcodegen dump --type json | jq -er '.targetTemplates.Installation.settings.base')
store=$(jq -er '.MODEL_STORE_RESOURCE // error("project.yml names no MODEL_STORE_RESOURCE")' <<<"$resources")
"$cli" model status --models-dir "$app/Contents/Resources/$store" >&2 \
  || fail "$app does not carry the default model whole"
driver=$(jq -er '.DRIVER_PACKAGE_RESOURCE // error("project.yml names no DRIVER_PACKAGE_RESOURCE")' <<<"$resources")
"$cli" driver check "$app/Contents/Resources/$driver" \
  || fail "$app does not carry the pinned driver package"
check "$app"
check "$app/Contents/MacOS/lowtalker-keyboardd"
# The CLI the app carries for a Mac with no checkout, which the release helper admits only
# because it is signed as the app is.
check "$app/Contents/Helpers/lowtalker"
# The input method bundle the app carries. Embedded content is signed on copy by Xcode
# rather than by its own target's codesign step, and the notary service refuses the whole
# upload for one nested bundle it dislikes, long after this script has printed the path as
# success.
#
# The bundle is asked, and its main executable is not, because they answer with one
# signature: `codesign -dvv` on `X.app/Contents/MacOS/X` resolves the path back to the
# bundle and prints byte-for-byte what `codesign -dvv X.app` prints - measured. A second
# `check` there is a second checkpoint for one rule that can never disagree with the first.
# [LAW:single-enforcer] `lowtalker-keyboardd` and `lowtalker` above are the opposite case and
# stay: each is a separate Mach-O in the app's bundle, with its own identifier and its own
# signature, which nothing else here reads.
#
# Found by looking rather than by name: the bundle is called after PRODUCT_NAME, which is
# project.yml's to decide, and a name spelled here is one more copy to keep in step. An app
# carrying none is a release whose third delivery does not exist, so it fails rather than
# passing a loop that ran zero times. [LAW:no-silent-failure]
methods=("$app"/Contents/Library/InputMethods/*.app)
[ -e "${methods[0]}" ] || fail "$app carries no input method bundle"
for method in "${methods[@]}"; do
  check "$method"
done
echo "$app"
